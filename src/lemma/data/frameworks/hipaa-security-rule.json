                "name": "citation",
                "value": "45 CFR 164.314(b)(1)"
              }
            ],
            "parts": [
              {
                "id": "164.314(b)(1)_smt",
                "name": "statement",
                "prose": "A group health plan's documents must incorporate provisions to require the plan sponsor to reasonably and appropriately safeguard ePHI created, received, maintained, or transmitted on behalf of the group health plan."
              }
            ]
          }
        ]
      },
      {
        "id": "164.316",
        "class": "family",
