                "id": "164.312(a)(2)(iv)",
                "class": "implementation-specification",
                "title": "Encryption and Decryption",
                "props": [
                  {
                    "name": "implementation",
                    "value": "Addressable"
                  }
                ],
                "parts": [
                  {
                    "id": "164.312(a)(2)(iv)_smt",
