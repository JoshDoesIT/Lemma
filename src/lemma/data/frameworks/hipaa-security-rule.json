                "class": "implementation-specification",
                "title": "Encryption",
                "props": [
                  {
                    "name": "implementation",
                    "value": "Addressable"
                  }
                ],
                "parts": [
                  {
                    "id": "164.312(e)(2)(ii)_smt",
