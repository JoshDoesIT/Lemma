                "name": "label",
                "value": "164.316(b)(1)"
              },
              {
                "name": "citation",
                "value": "45 CFR 164.316(b)(1)"
              }
            ],
            "parts": [
              {
                "id": "164.316(b)(1)_smt",
                "name": "statement",
                "prose": "Maintain the policies and procedures implemented to comply with the Security Rule in written (which may be electronic) form, and maintain a written record of any action, activity, or assessment required to be documented."
              }
            ],
            "controls": [
              {
                "id": "164.316(b)(2)(i)",
                "class": "implementation-specification",
                "title": "Time Limit",
                "props": [
                  {
                    "name": "implementation",
                    "value": "Required"
                  }
                ],
                "parts": [
                  {
                    "id": "164.316(b)(2)(i)_smt",
                    "name": "statement",
                    "prose": "Retain the documentation for 6 years from the date of its creation or the date when it last was in effect, whichever is later."
                  }
                ]
              },
              {
                "id": "164.316(b)(2)(ii)",
                "class": "implementation-specification",
                "title": "Availability",
