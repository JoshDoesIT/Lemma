            "props": [
              {
                "name": "label",
                "value": "164.316(a)"
              },
              {
                "name": "citation",
                "value": "45 CFR 164.316(a)"
              }
            ],
            "parts": [
              {
                "id": "164.316(a)_smt",
                "name": "statement",
                "prose": "Implement reasonable and appropriate policies and procedures to comply with the standards, implementation specifications, and other requirements of the Security Rule."
              }
            ]
          },
          {
            "id": "164.316(b)(1)",
            "class": "standard",
            "title": "Documentation",
            "props": [
