                "name": "citation",
                "value": "45 CFR 164.312(d)"
              }
            ],
            "parts": [
              {
                "id": "164.312(d)_smt",
                "name": "statement",
                "prose": "Implement procedures to verify that a person or entity seeking access to ePHI is the one claimed."
              }
            ]
          },
          {
            "id": "164.312(e)(1)",
            "class": "standard",
            "title": "Transmission Security",
            "props": [
              {
                "name": "label",
                "value": "164.312(e)(1)"
