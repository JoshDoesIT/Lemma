                "value": "45 CFR 164.312(e)(1)"
              }
            ],
            "parts": [
              {
                "id": "164.312(e)(1)_smt",
                "name": "statement",
                "prose": "Implement technical security measures to guard against unauthorized access to ePHI that is being transmitted over an electronic communications network."
              }
            ],
            "controls": [
