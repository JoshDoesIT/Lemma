                "id": "164.312(e)(2)(i)",
                "class": "implementation-specification",
                "title": "Integrity Controls",
                "props": [
                  {
                    "name": "implementation",
                    "value": "Addressable"
                  }
                ],
                "parts": [
                  {
                    "id": "164.312(e)(2)(i)_smt",
                    "name": "statement",
