              },
              {
                "name": "citation",
                "value": "45 CFR 164.312(b)"
              }
            ],
            "parts": [
              {
                "id": "164.312(b)_smt",
                "name": "statement",
                "prose": "Implement hardware, software, and/or procedural mechanisms that record and examine activity in information systems that contain or use ePHI."
              }
            ]
          },
          {
            "id": "164.312(c)(1)",
            "class": "standard",
            "title": "Integrity",
            "props": [
              {
                "name": "label",
                "value": "164.312(c)(1)"
              },
              {
                "name": "citation",
                "value": "45 CFR 164.312(c)(1)"
              }
            ],
            "parts": [
              {
                "id": "164.312(c)(1)_smt",
                "name": "statement",
                "prose": "Implement policies and procedures to protect ePHI from improper alteration or destruction."
              }
            ],
            "controls": [
              {
                "id": "164.312(c)(2)",
                "class": "implementation-specification",
                "title": "Mechanism to Authenticate ePHI",
                "props": [
                  {
                    "name": "implementation",
                    "value": "Addressable"
                  }
                ],
                "parts": [
                  {
                    "id": "164.312(c)(2)_smt",
                    "name": "statement",
                    "prose": "Implement electronic mechanisms to corroborate that ePHI has not been altered or destroyed in an unauthorized manner."
                  }
                ]
              }
            ]
          },
