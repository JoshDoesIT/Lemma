                "id": "164.314(a)(1)_smt",
                "name": "statement",
                "prose": "The contract or other arrangement between the covered entity and its business associate must meet the requirements of this section, as applicable."
              }
            ]
          },
          {
            "id": "164.314(b)(1)",
            "class": "standard",
            "title": "Requirements for Group Health Plans",
            "props": [
              {
                "name": "label",
                "value": "164.314(b)(1)"
