                    "name": "implementation",
                    "value": "Required"
                  }
                ],
                "parts": [
                  {
                    "id": "164.312(a)(2)(ii)_smt",
                    "name": "statement",
                    "prose": "Establish procedures for obtaining necessary ePHI during an emergency."
                  }
                ]
              },
              {
                "id": "164.312(a)(2)(iii)",
                "class": "implementation-specification",
                "title": "Automatic Logoff",
                "props": [
                  {
                    "name": "implementation",
                    "value": "Addressable"
                  }
                ],
                "parts": [
                  {
                    "id": "164.312(a)(2)(iii)_smt",
