{
  "catalog": {
    "uuid": "bc559fb2-e1d8-55ad-bfd8-6342470f2b8b",
    "metadata": {
      "title": "CMMC Level 1 (Foundational)",
      "version": "2.0",
      "oscal-version": "1.1.2",
      "props": [
        {
          "name": "source",
          "value": "Cybersecurity Maturity Model Certification (CMMC) Level 1, derived from FAR 52.204-21(b)(1) Basic Safeguarding of Covered Contractor Information Systems"
        },
        {
          "name": "note",
          "value": "Practices derive from FAR 52.204-21, public-domain US federal regulation. Curated for Lemma's Community Framework Library; not legal advice."
        }
      ]
    },
    "groups": [
      {
        "id": "AC",
        "class": "domain",
        "title": "Access Control",
        "controls": [
          {
            "id": "AC.L1-3.1.1",
            "class": "practice",
            "title": "Authorized Access Control",
            "props": [
              {
                "name": "label",
                "value": "AC.L1-3.1.1"
              },
              {
                "name": "citation",
                "value": "FAR 52.204-21(b)(1)(i)"
              }
            ],
            "parts": [
              {
                "id": "AC.L1-3.1.1_smt",
                "name": "statement",
                "prose": "Limit information system access to authorized users, processes acting on behalf of authorized users, or devices (including other information systems)."
              }
            ]
          },
          {
            "id": "AC.L1-3.1.2",
            "class": "practice",
            "title": "Transaction & Function Control",
            "props": [
              {
                "name": "label",
                "value": "AC.L1-3.1.2"
              },
              {
                "name": "citation",
                "value": "FAR 52.204-21(b)(1)(ii)"
              }
            ],
            "parts": [
              {
                "id": "AC.L1-3.1.2_smt",
                "name": "statement",
                "prose": "Limit information system access to the types of transactions and functions that authorized users are permitted to execute."
              }
            ]
          },
          {
            "id": "AC.L1-3.1.20",
            "class": "practice",
            "title": "External Connections",
            "props": [
              {
                "name": "label",
                "value": "AC.L1-3.1.20"
              },
              {
                "name": "citation",
                "value": "FAR 52.204-21(b)(1)(iii)"
              }
            ],
            "parts": [
              {
                "id": "AC.L1-3.1.20_smt",
                "name": "statement",
                "prose": "Verify and control/limit connections to and use of external information systems."
              }
            ]
          },
          {
            "id": "AC.L1-3.1.22",
            "class": "practice",
            "title": "Control Public Information",
            "props": [
              {
                "name": "label",
                "value": "AC.L1-3.1.22"
              },
              {
                "name": "citation",
                "value": "FAR 52.204-21(b)(1)(iv)"
              }
            ],
            "parts": [
              {
                "id": "AC.L1-3.1.22_smt",
                "name": "statement",
                "prose": "Control information posted or processed on publicly accessible information systems."
              }
            ]
          }
        ]
      },
      {
        "id": "IA",
        "class": "domain",
        "title": "Identification and Authentication",
        "controls": [
          {
            "id": "IA.L1-3.5.1",
            "class": "practice",
            "title": "Identification",
            "props": [
              {
                "name": "label",
                "value": "IA.L1-3.5.1"
              },
              {
                "name": "citation",
                "value": "FAR 52.204-21(b)(1)(v)"
              }
            ],
            "parts": [
              {
                "id": "IA.L1-3.5.1_smt",
                "name": "statement",
                "prose": "Identify information system users, processes acting on behalf of users, or devices."
              }
            ]
          },
          {
            "id": "IA.L1-3.5.2",
            "class": "practice",
            "title": "Authentication",
            "props": [
              {
                "name": "label",
                "value": "IA.L1-3.5.2"
              },
              {
                "name": "citation",
                "value": "FAR 52.204-21(b)(1)(vi)"
              }
            ],
            "parts": [
              {
                "id": "IA.L1-3.5.2_smt",
                "name": "statement",
                "prose": "Authenticate (or verify) the identities of those users, processes, or devices, as a prerequisite to allowing access to organizational information systems."
              }
            ]
          }
        ]
      },
      {
        "id": "MP",
        "class": "domain",
        "title": "Media Protection",
        "controls": [
          {
            "id": "MP.L1-3.8.3",
            "class": "practice",
            "title": "Media Disposal",
            "props": [
              {
                "name": "label",
                "value": "MP.L1-3.8.3"
              },
              {
                "name": "citation",
                "value": "FAR 52.204-21(b)(1)(vii)"
              }
            ],
            "parts": [
              {
                "id": "MP.L1-3.8.3_smt",
                "name": "statement",
                "prose": "Sanitize or destroy information system media containing Federal Contract Information before disposal or release for reuse."
              }
            ]
          }
        ]
      },
      {
        "id": "PE",
        "class": "domain",
        "title": "Physical Protection",
        "controls": [
          {
            "id": "PE.L1-3.10.1",
            "class": "practice",
            "title": "Limit Physical Access",
            "props": [
              {
                "name": "label",
                "value": "PE.L1-3.10.1"
              },
              {
                "name": "citation",
                "value": "FAR 52.204-21(b)(1)(viii)"
              }
            ],
            "parts": [
              {
                "id": "PE.L1-3.10.1_smt",
                "name": "statement",
                "prose": "Limit physical access to organizational information systems, equipment, and the respective operating environments to authorized individuals."
              }
            ]
          },
          {
            "id": "PE.L1-3.10.3",
            "class": "practice",
            "title": "Escort Visitors",
            "props": [
              {
                "name": "label",
                "value": "PE.L1-3.10.3"
              },
              {
                "name": "citation",
                "value": "FAR 52.204-21(b)(1)(ix)"
              }
            ],
            "parts": [
              {
                "id": "PE.L1-3.10.3_smt",
                "name": "statement",
                "prose": "Escort visitors and monitor visitor activity."
              }
            ]
          },
          {
            "id": "PE.L1-3.10.4",
            "class": "practice",
            "title": "Physical Access Logs",
            "props": [
              {
                "name": "label",
                "value": "PE.L1-3.10.4"
              },
              {
                "name": "citation",
                "value": "FAR 52.204-21(b)(1)(ix)"
              }
            ],
            "parts": [
              {
                "id": "PE.L1-3.10.4_smt",
                "name": "statement",
                "prose": "Maintain audit logs of physical access."
              }
            ]
          },
          {
            "id": "PE.L1-3.10.5",
            "class": "practice",
            "title": "Manage Physical Access",
            "props": [
              {
                "name": "label",
                "value": "PE.L1-3.10.5"
              },
              {
                "name": "citation",
                "value": "FAR 52.204-21(b)(1)(ix)"
              }
            ],
            "parts": [
              {
                "id": "PE.L1-3.10.5_smt",
                "name": "statement",
                "prose": "Control and manage physical access devices."
              }
            ]
          }
        ]
      },
      {
        "id": "SC",
        "class": "domain",
        "title": "System and Communications Protection",
        "controls": [
          {
            "id": "SC.L1-3.13.1",
            "class": "practice",
            "title": "Boundary Protection",
            "props": [
              {
                "name": "label",
                "value": "SC.L1-3.13.1"
              },
              {
                "name": "citation",
                "value": "FAR 52.204-21(b)(1)(x)"
              }
            ],
            "parts": [
              {
                "id": "SC.L1-3.13.1_smt",
                "name": "statement",
                "prose": "Monitor, control, and protect organizational communications (i.e., information transmitted or received by organizational information systems) at the external boundaries and key internal boundaries of the information systems."
              }
            ]
          },
          {
            "id": "SC.L1-3.13.5",
            "class": "practice",
            "title": "Public-Access System Separation",
            "props": [
              {
                "name": "label",
                "value": "SC.L1-3.13.5"
              },
              {
                "name": "citation",
                "value": "FAR 52.204-21(b)(1)(xi)"
              }
            ],
            "parts": [
              {
                "id": "SC.L1-3.13.5_smt",
                "name": "statement",
                "prose": "Implement subnetworks for publicly accessible system components that are physically or logically separated from internal networks."
              }
            ]
          }
        ]
      },
      {
        "id": "SI",
        "class": "domain",
        "title": "System and Information Integrity",
        "controls": [
          {
            "id": "SI.L1-3.14.1",
            "class": "practice",
            "title": "Flaw Remediation",
            "props": [
              {
                "name": "label",
                "value": "SI.L1-3.14.1"
              },
              {
                "name": "citation",
                "value": "FAR 52.204-21(b)(1)(xii)"
              }
            ],
            "parts": [
              {
                "id": "SI.L1-3.14.1_smt",
                "name": "statement",
                "prose": "Identify, report, and correct information and information system flaws in a timely manner."
              }
            ]
          },
          {
            "id": "SI.L1-3.14.2",
            "class": "practice",
            "title": "Malicious Code Protection",
            "props": [
              {
                "name": "label",
                "value": "SI.L1-3.14.2"
              },
              {
                "name": "citation",
                "value": "FAR 52.204-21(b)(1)(xiii)"
              }
            ],
            "parts": [
              {
                "id": "SI.L1-3.14.2_smt",
                "name": "statement",
                "prose": "Provide protection from malicious code at appropriate locations within organizational information systems."
              }
            ]
          },
          {
            "id": "SI.L1-3.14.4",
            "class": "practice",
            "title": "Update Malicious Code Protection",
            "props": [
              {
                "name": "label",
                "value": "SI.L1-3.14.4"
              },
              {
                "name": "citation",
                "value": "FAR 52.204-21(b)(1)(xiv)"
              }
            ],
            "parts": [
              {
                "id": "SI.L1-3.14.4_smt",
                "name": "statement",
                "prose": "Update malicious code protection mechanisms when new releases are available."
              }
            ]
          },
          {
            "id": "SI.L1-3.14.5",
            "class": "practice",
            "title": "System & File Scanning",
            "props": [
              {
                "name": "label",
                "value": "SI.L1-3.14.5"
              },
              {
                "name": "citation",
                "value": "FAR 52.204-21(b)(1)(xv)"
              }
            ],
            "parts": [
              {
                "id": "SI.L1-3.14.5_smt",
                "name": "statement",
                "prose": "Perform periodic scans of the information system and real-time scans of files from external sources as files are downloaded, opened, or executed."
              }
            ]
          }
        ]
      }
    ]
  }
}
